{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "idhf",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_vars": true,
	"vars": {
		"CF_WORKER": "1",
		"DB_ADAPTER": "postgres"
	},
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "d6280f4ae10e4d3a93ade9bdb7d72776"
		}
	]
}
