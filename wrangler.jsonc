{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "idhf",
	"compatibility_date": "2026-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": true,
			"head_sampling_rate": 1
		}
	}
}