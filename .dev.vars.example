# Local secrets for `wrangler dev` (and `pnpm run check:cf`).
# Copy to `.dev.vars` — that file is gitignored and should never be committed.
# Docs: https://developers.cloudflare.com/workers/configuration/environment-variables/#interact-with-environment-variables-locally

# Signals the app that it's running on the Workers runtime, so payload.config.ts
# selects the production Postgres adapter instead of the dev SQLite one.
CF_WORKER=1

# For local `wrangler dev`, if you've added the `HYPERDRIVE` binding to
# wrangler.jsonc with a `localConnectionString`, the real connection string is
# injected automatically. Otherwise point directly at your Postgres:
HYPERDRIVE_URL=postgres://user:pass@host:5432/db

# Same values as .env
PAYLOAD_SECRET=YOUR_SECRET_HERE
PLUNK_API_KEY=