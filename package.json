{
  "name": "payload-tanstack-blank",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" payload build",
    "build:cf": "pnpm build",
    "check:cf": "pnpm build:cf && wrangler pages dev dist --port 8788",
    "deploy:cf": "pnpm build:cf && wrangler pages deploy dist --project-name=idoma-hof",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation vite dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation vite preview",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.10",
    "@payloadcms/db-sqlite": "4.0.0-canary.17",
    "@payloadcms/graphql": "4.0.0-canary.17",
    "@payloadcms/plugin-mcp": "4.0.0-canary.17",
    "@payloadcms/richtext-lexical": "4.0.0-canary.17",
    "@payloadcms/tanstack-start": "4.0.0-canary.17",
    "@payloadcms/ui": "4.0.0-canary.17",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-start": "1.168.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.8.1",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "nitro": "npm:nitro-nightly@latest",
    "payload": "4.0.0-canary.17",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sass": "^1.101.0",
    "shadcn": "^4.21.0",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "^9.16.0",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.6",
    "wrangler": "^4.136.3"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
