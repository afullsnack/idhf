# --- Local development (Payload SQLite) ---------------------------------------
# Path to the local SQLite database file. Payload auto-creates it on first run.
DATABASE_URL=file:dev.db
# Optional. Only used for remote libSQL/Turso instances — ignore for local files.
DATABASE_AUTH_TOKEN=

# --- Schema migrations against the production Postgres ------------------------
# Run from the Node CLI (not stored in .env for dev — pass inline so `pnpm dev`
# keeps using SQLite). `DB_ADAPTER=postgres` routes `payload migrate` to the
# Postgres adapter; `PROD_DATABASE_URL` is the database's direct connection
# string (the same you gave Hyperdrive).
#
#   PROD_DATABASE_URL="postgres://..." DB_ADAPTER=postgres pnpm run payload migrate

# --- Shared -------------------------------------------------------------------
# Used by Payload to sign JWTs and encrypt hooks/secrets. Use a long random string.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Plunk email platform — used by the newsletter subscribe server function.
# Create one at https://app.useplunk.com > Settings > API Keys (or your self-hosted Plunk).
PLUNK_API_KEY=

# --- Cloudflare Workers (production) ------------------------------------------
# In production the DB is Postgres behind a Cloudflare Hyperdrive binding named
# `HYPERDRIVE`. The connection string is injected by the platform at runtime —
# no env var needed. The adapter resolves it in this order:
#   1. env.HYPERDRIVE.connectionString   (Worker binding)
#   2. HYPERDRIVE_URL                     (local `wrangler dev` fallback)
#   3. DATABASE_URL                       (direct Postgres, for CLI/migrations from Node)
#
# Set up once (saves nothing in this file):
#   npx wrangler hyperdrive create idhf-hyperdrive --connection-string="postgres://user:pass@host:5432/db"
#   -> then add the returned id to the `hyperdrive` binding array in wrangler.jsonc
#   -> DATABASE_URL above can then be used by `payload migrate` against the real DB.
HYPERDRIVE_URL=postgres://user:pass@host:5432/db