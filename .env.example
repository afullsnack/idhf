# --- Payload ------------------------------------------------------------------
# Used by Payload to sign JWTs and encrypt hooks/secrets. Use a long random string.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Database (Postgres) -------------------------------------------------------
# The postgres adapter is configured against this connection string. In
# production (Vercel), set this to your managed Postgres (e.g. Neon) URI.
PROD_DATABASE_URL=postgres://user:pass@host:5432/db

# --- Vercel Blob ---------------------------------------------------------------
# Read/write token created in Vercel Storage > Blob. Required for uploading
# media through the Payload admin; uploaded files are stored in Blob instead of
# the local filesystem.
BLOB_READ_WRITE_TOKEN=

# --- Newsletter / Email --------------------------------------------------------
# Plunk email platform — used for transactional emails (Payload email adapter)
# and the newsletter subscribe endpoint. Create one at https://app.useplunk.com
# > Settings > API Keys (use a secret `sk_*` key).
PLUNK_API_KEY=

# Sender used as the default "from" on transactional emails (domain must be
# verified in Plunk).
EMAIL_FROM_ADDRESS=noreply@idomahalloffame.org
EMAIL_FROM_NAME=Idoma Hall of Fame